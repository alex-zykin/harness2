{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness2-business:result:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "authority": {
      "const": "advisory_only"
    },
    "policy": {
      "enum": [
        "draft_only",
        "suppress",
        "insufficient"
      ]
    },
    "next_step": {
      "enum": [
        "review_draft",
        "record_opt_out",
        "request_details",
        "verify_signal",
        "request_permission"
      ]
    },
    "evidence_event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
      }
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "authority",
    "policy",
    "next_step",
    "evidence_event_ids"
  ],
  "additionalProperties": false
}
